<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:AvoxControls.SourcePlayer"
             x:Class="AvoxControls.SourcePlayer.TestSourceView">

    <Grid>
        <!-- 主界面 - 始终保留在视觉树中 -->
        <controls:TestSourceMainView x:Name="MainView" />

        <!-- 设置界面 - 通过 IsVisible 控制显示/隐藏 -->
        <Border x:Name="SettingsOverlay"
                IsVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border.Background>
                <SolidColorBrush Color="White"/>
            </Border.Background>
            <controls:SourceSettingView x:Name="SettingsView"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>
        </Border>
    </Grid>

</UserControl>
