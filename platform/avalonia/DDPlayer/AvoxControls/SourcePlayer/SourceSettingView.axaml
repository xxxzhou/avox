<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:AvoxCommon;assembly=AvoxCommon"
             xmlns:converters="clr-namespace:AvoxControls.Converters;assembly=AvoxControls"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="AvoxControls.SourcePlayer.SourceSettingView"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Margin="15" Background="#FFFFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标签页控件 -->
        <TabControl Grid.Row="0">
            <!-- 渲染设置 -->
            <TabItem Header="渲染设置">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="15">

                        <!-- 渲染引擎选择 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="渲染引擎" FontWeight="Bold" Margin="0,0,0,5" />
                                <CheckBox Content="使用 Vulkan 渲染" IsChecked="{Binding Playback.UseVulkanRendering}" />
                                <TextBlock Text="Vulkan: 跨平台高性能渲染&#x0a;关闭: 使用平台原生渲染(DX11/Metal/OpenGLES)"
                                           Foreground="Gray"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 水印设置 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="水印设置" FontWeight="Bold" Margin="0,0,0,5" />
                                <CheckBox Content="启用水印" IsChecked="{Binding Playback.EnableWatermark}" />

                                <!-- 水印详细设置 -->
                                <Grid IsEnabled="{Binding Playback.EnableWatermark}" Margin="20,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 水印图片路径 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="水印图片:" VerticalAlignment="Center" Margin="0,5" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding Playback.WatermarkPath}"
                                             Watermark="assets/images下的文件名或绝对路径"
                                             Width="200"
                                             HorizontalAlignment="Left" />

                                    <!-- 中心 X 坐标 (归一化) -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="中心 X (0-1):" VerticalAlignment="Center" Margin="0,5" />
                                    <Slider Grid.Row="1" Grid.Column="1"
                                            Value="{Binding Playback.WatermarkCenterX}"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.01"
                                            Width="200"
                                            HorizontalAlignment="Left" />

                                    <!-- 中心 Y 坐标 (归一化) -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="中心 Y (0-1):" VerticalAlignment="Center" Margin="0,5" />
                                    <Slider Grid.Row="2" Grid.Column="1"
                                            Value="{Binding Playback.WatermarkCenterY}"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.01"
                                            Width="200"
                                            HorizontalAlignment="Left" />

                                    <!-- 宽度 (归一化) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="宽度 (0-1):" VerticalAlignment="Center" Margin="0,5" />
                                    <Slider Grid.Row="3" Grid.Column="1"
                                            Value="{Binding Playback.WatermarkWidth}"
                                            Minimum="0.01"
                                            Maximum="1"
                                            TickFrequency="0.01"
                                            Width="200"
                                            HorizontalAlignment="Left" />

                                    <!-- 高度 (归一化) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="高度 (0-1):" VerticalAlignment="Center" Margin="0,5" />
                                    <Slider Grid.Row="4" Grid.Column="1"
                                            Value="{Binding Playback.WatermarkHeight}"
                                            Minimum="0.01"
                                            Maximum="1"
                                            TickFrequency="0.01"
                                            Width="200"
                                            HorizontalAlignment="Left" />

                                    <!-- 透明度 -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="透明度 (0-1):" VerticalAlignment="Center" Margin="0,5" />
                                    <Slider Grid.Row="5" Grid.Column="1"
                                            Value="{Binding Playback.WatermarkAlpha}"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.1"
                                            Width="200"
                                            HorizontalAlignment="Left" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 字体显示设置 (语音识别结果) -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10"
                                IsEnabled="{Binding Stt.EnableStt}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="语音识别文本显示" FontWeight="Bold" Margin="0,0,0,5" />

                                <!-- 字体缩放 -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字体缩放:" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Value="{Binding Stt.FontScale}"
                                            Minimum="0.5"
                                            Maximum="4.0"
                                            TickFrequency="0.1"
                                            Width="200"
                                            HorizontalAlignment="Left" />
                                </Grid>

                                <!-- 字体颜色 -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="字体颜色:" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <Button Content="白色" Click="OnFontColorWhiteClick" Padding="10,5" />
                                        <Button Content="红色" Click="OnFontColorRedClick" Padding="10,5" />
                                        <Button Content="黄色" Click="OnFontColorYellowClick" Padding="10,5" />
                                        <Button Content="绿色" Click="OnFontColorGreenClick" Padding="10,5" />
                                    </StackPanel>
                                </Grid>

                                <!-- 显示位置 X -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="位置 X (0-1):" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Value="{Binding Stt.LayoutX}"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            Width="200"
                                            HorizontalAlignment="Left" />
                                </Grid>

                                <!-- 显示位置 Y -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="位置 Y (0-1):" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Value="{Binding Stt.LayoutY}"
                                            Minimum="0"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            Width="200"
                                            HorizontalAlignment="Left" />
                                </Grid>

                                <!-- 显示宽度 -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="宽度 (0-1):" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Value="{Binding Stt.LayoutWidth}"
                                            Minimum="0.1"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            Width="200"
                                            HorizontalAlignment="Left" />
                                </Grid>

                                <TextBlock Text="识别文本将显示在视频画面指定位置"
                                           Foreground="Gray"
                                           FontSize="11"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 编码设置 -->
            <TabItem Header="编码设置">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="15">

                        <!-- 视频编码选择 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="视频编码" FontWeight="Bold" Margin="0,0,0,5" />
                                <StackPanel x:Name="VideoCodecPanel" Spacing="5" />
                            </StackPanel>
                        </Border>

                        <!-- 音频编码选择 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="音频编码" FontWeight="Bold" Margin="0,0,0,5" />
                                <StackPanel x:Name="AudioCodecPanel" Spacing="5" />
                            </StackPanel>
                        </Border>

                        <!-- 录制模式选择 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="录制模式" FontWeight="Bold" Margin="0,0,0,5" />
                                <StackPanel x:Name="RecordModePanel" Spacing="5" />
                            </StackPanel>
                        </Border>

                        <!-- 复用器类型选择 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="复用器类型" FontWeight="Bold" Margin="0,0,0,5" />
                                <StackPanel x:Name="MuxerTypePanel" Spacing="5" />
                            </StackPanel>
                        </Border>

                        <!-- 网络推流地址 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="网络推流地址" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBox x:Name="PushUrlTextBox"
                                         Text="{Binding Encoding.PushUrl}"
                                         Watermark="rtmp://live.example.com/stream"
                                         HorizontalAlignment="Stretch" />
                                <TextBlock Text="支持 RTMP/RTSP 等推流协议"
                                           Foreground="Gray"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- 本地保存目录 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="本地保存目录" FontWeight="Bold" Margin="0,0,0,5" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="LocalPathTextBox"
                                             Grid.Column="0"
                                             Text="{Binding Encoding.LocalPath}"
                                             Watermark="选择本地保存目录"
                                             HorizontalAlignment="Stretch"
                                             Margin="0,0,5,0" />
                                    <Button Grid.Column="1"
                                            Content="浏览..."
                                            Click="OnBrowseLocalPathClick"
                                            Width="70" />
                                </Grid>
                                <TextBlock Text="留空则使用默认路径"
                                           Foreground="Gray"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 语音识别设置 -->
            <TabItem Header="语音识别">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="15">

                        <!-- 启用语音识别 -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="语音识别 (ASR)" FontWeight="Bold" Margin="0,0,0,5" />
                                <CheckBox Content="启用语音识别" IsChecked="{Binding Stt.EnableStt}" />
                                <TextBlock Text="启用后将识别音频中的语音内容&#x0a;SourcePlayer 使用流式模式，只支持中英文识别"
                                           Foreground="Gray"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>

                        <!-- 翻译设置（SourcePlayer 不支持翻译，仅提示） -->
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10"
                                IsEnabled="{Binding Stt.EnableStt}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="翻译设置" FontWeight="Bold" Margin="0,0,0,5" />
                                <TextBlock Text="SourcePlayer 流式模式不支持翻译功能&#x0a;如需翻译，请使用 MediaPlayer 的 PTS 同步模式"
                                           Foreground="Gray"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确定" Click="OKButton_Click" Margin="0,0,10,0" Width="80" />
            <Button Content="取消" Click="CancelButton_Click" Width="80" />
        </StackPanel>
    </Grid>
</UserControl>
