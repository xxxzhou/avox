<Window xmlns="https://github.com/avaloniaui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avox="clr-namespace:AvoxNet;assembly=AvoxNet"
             xmlns:ac="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:local="using:AvoxCommon"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="AvoxControls.SettingsWindow" 
             x:DataType="local:PlayerConfig"
             Title="设置" Width="600" Height="400">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- 标签页控件 -->
        <TabControl Grid.Row="0">
            <!-- 播放设置 -->
            <TabItem Header="播放设置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <CheckBox Grid.Row="0" Content="启用硬件解码" IsChecked="{Binding Playback.EnableHardwareDecoding}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="1" Content="使用Vulkan渲染" IsChecked="{Binding Playback.UseVulkanRendering}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="2" Content="启用低延迟模式" IsChecked="{Binding Playback.EnableLowLatency}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="3" Content="自动播放" IsChecked="{Binding Playback.AutoPlay}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="4" Content="启用跳帧" IsChecked="{Binding Playback.EnableFrameSkip}" Margin="0,0,0,10" />
                    
                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="缓冲大小 (毫秒):" Width="120" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Playback.BufferSizeMs}" Minimum="500" Maximum="10000" Increment="100" Width="100" />
                    </StackPanel>
                    
                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="默认音量:" Width="120" VerticalAlignment="Center" />
                        <Slider Value="{Binding Playback.DefaultVolume}" Minimum="0" Maximum="1" TickFrequency="0.1" Width="200" />
                        <TextBlock Text="{Binding Playback.DefaultVolume, StringFormat={}{0:P0}}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- 网络设置 -->
            <TabItem Header="网络设置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <CheckBox Grid.Row="0" Content="启用网络缓存" IsChecked="{Binding Network.EnableNetworkCache}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="1" Content="启用TCP_NODELAY" IsChecked="{Binding Network.EnableTcpNoDelay}" Margin="0,0,0,10" />
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="网络延迟 (毫秒):" Width="120" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Network.LatencyMs}" Minimum="0" Maximum="5000" Increment="100" Width="100" />
                    </StackPanel>
                    
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="网络超时 (毫秒):" Width="120" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Network.NetworkTimeoutMs}" Minimum="1000" Maximum="30000" Increment="1000" Width="100" />
                    </StackPanel>
                    
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="重试次数:" Width="120" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Network.RetryCount}" Minimum="0" Maximum="10" Increment="1" Width="100" />
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- 界面设置 -->
            <TabItem Header="界面设置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <CheckBox Grid.Row="0" Content="播放时自动全屏" IsChecked="{Binding Interface.EnableFullscreenOnPlay}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="1" Content="自动隐藏控制栏" IsChecked="{Binding Interface.EnableControlsAutoHide}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="2" Content="启用系统托盘" IsChecked="{Binding Interface.EnableSystemTray}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="3" Content="启用动画效果" IsChecked="{Binding Interface.EnableAnimations}" Margin="0,0,0,10" />
                    
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="控制栏隐藏延迟 (毫秒):" Width="160" VerticalAlignment="Center" />
                        <NumericUpDown Value="{Binding Interface.ControlsHideDelay}" Minimum="1000" Maximum="10000" Increment="500" Width="100" />
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <!-- 高级设置 -->
            <TabItem Header="高级设置">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <CheckBox Grid.Row="0" Content="启用调试日志" IsChecked="{Binding Advanced.EnableDebugLogs}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="1" Content="启用性能监控" IsChecked="{Binding Advanced.EnablePerformanceMonitoring}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="2" Content="启用GPU加速" IsChecked="{Binding Advanced.EnableGpuAcceleration}" Margin="0,0,0,10" />
                    <CheckBox Grid.Row="3" Content="启用内存优化" IsChecked="{Binding Advanced.EnableMemoryOptimization}" Margin="0,0,0,10" />
                </Grid>
            </TabItem>
            
            <!-- IO方案设置 -->
            <TabItem Header="IO方案">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="IO方案选择" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />
                    
                    <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,15">
                        <RadioButton Content="FFmpeg" Name="FFmpegRadio" Margin="0,0,0,5" Checked="FFmpegRadio_Checked" Unchecked="FFmpegRadio_Unchecked" />
                        <RadioButton Content="ZLMediaKit" Name="ZLMediaKitRadio" Checked="ZLMediaKitRadio_Checked" Unchecked="ZLMediaKitRadio_Unchecked" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- 按钮区域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Click="OKButton_Click" Margin="0,0,10,0" Width="80" />
            <Button Content="取消" Click="CancelButton_Click" Width="80" />
        </StackPanel>
    </Grid>
</Window>