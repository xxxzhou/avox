<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AvaPlayer"
             x:Class="AvaPlayer.App"
             RequestedThemeVariant="Light">
             <!-- 强制使用浅色主题，避免Android深色主题导致文字颜色异常 -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>