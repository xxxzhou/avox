// 线性光 -> sRGB 转换 (FSR 线性空间出口)
// 输入线性光 rgba16f, 输出 sRGB 编码 rgba8, 回到显示空间 (放锐化之后)
#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba16f) uniform readonly image2D inTex;
layout (binding = 1, rgba8) uniform image2D outTex;

// sRGB OETF: x <= 0.0031308 ? x*12.92 : 1.055*x^(1/2.4) - 0.055
vec3 linearToSrgb(vec3 c) {
    vec3 usePw = step(vec3(0.0031308), c);
    vec3 lo = c * 12.92;
    vec3 hi = 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
    return mix(lo, hi, usePw);
}

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if (uv.x >= size.x || uv.y >= size.y) {
        return;
    }
    vec4 c = imageLoad(inTex, uv);
    c.rgb = clamp(linearToSrgb(c.rgb), 0.0, 1.0);
    imageStore(outTex, uv, c);
}
