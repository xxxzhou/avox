#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D srcTex;
layout(binding = 1) uniform sampler2D convLastTex;
layout(binding = 2, rgba8) uniform writeonly image2D dstTex;
layout(std140, binding = 3) uniform UBO {
	int srcWidth;
	int srcHeight;
	int dstWidth;
	int dstHeight;
} ubo;

void main() {
	ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
	if (pos.x >= ubo.dstWidth || pos.y >= ubo.dstHeight) return;

	vec2 dstTexelSize = 1.0 / vec2(ubo.dstWidth, ubo.dstHeight);
	vec2 srcTexelSize = 1.0 / vec2(ubo.srcWidth, ubo.srcHeight);
	vec2 dstUV = (vec2(pos) + 0.5) * dstTexelSize;

	// Map to low-resolution coordinates
	vec2 srcPos = vec2(pos) * 0.5;
	ivec2 srcIdx = ivec2(srcPos);
	vec2 fracPos = fract(srcPos);
	ivec2 subPixel = ivec2(fracPos * 2.0);
	int channelIndex = subPixel.y * 2 + subPixel.x;

	// Sample low-resolution 4ch feature map at nearest texel center
	vec2 lowResUV = (vec2(srcIdx) + 0.5) * srcTexelSize;
	vec4 features = texture(convLastTex, lowResUV);

	// Select channel based on sub-pixel position (depth-to-space)
	float delta = features[channelIndex];

	// Residual: add bilinearly upsampled original
	vec4 original = texture(srcTex, dstUV);
	vec4 result = vec4(delta) + original;

	imageStore(dstTex, pos, result);
}
