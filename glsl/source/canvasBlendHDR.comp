#version 450

// ASS/PGS 字幕 canvas source-over 混合·16F 线性域变体(字幕画布多后端渲染计划 §5.4)
// forceHDR 拓扑(链F 升样后 / yuv2rgba HDR 变体)帧在扩展线性域: 1.0 = SDR 白
// 80nit(与 pqUpsample.comp 归一化同源, *125.0)。canvas 仍 rgba8 SDR gamma 域,
// 采样后在 shader 内线性化×参考白再混合, 域正确且零额外 pass。
// 参考白权威源 = avox/subtitle/CanvasBlendMath.hpp(kCanvasSdrRefWhiteNits
// 203nit → 203/80 = 2.5375), 勿单侧改动。

layout(local_size_x = 16, local_size_y = 16) in; // gl_WorkGroupSize
// 视频帧(16F 线性域, 1.0 = 80nit)
layout(binding = 0, rgba16f) uniform readonly image2D inTex;
// 字幕画布(premultiplied alpha, SDR gamma 域), 线性采样
layout(binding = 1) uniform sampler2D inTex2;
// 输出(16F 线性域)
layout(binding = 2, rgba16f) uniform image2D outTex;

layout(std140, binding = 3) uniform UBO {
  // 变换后门控矩形中心与宽高(帧的归一化坐标)
  float centerX;
  float centerY;
  float width;
  float height;
  // 整层不透明度(0=直通/无字幕, 1=完全显示)
  float opacity;
  // 采样反算仿射原点与 1/scale(与 CanvasBlendParamet 严格同序)
  float originX;
  float originY;
  float invScale;
}
ubo;

// BT.709 逆 OETF(canvas SDR 码值 → 相对线性光, 白=1.0)
vec3 sdrToLinear(vec3 v) {
  v = clamp(v, vec3(0.0), vec3(1.0));
  vec3 hi = pow((v + vec3(0.099)) / vec3(1.099), vec3(1.0 / 0.45));
  vec3 lo = v / vec3(4.5);
  return mix(hi, lo, vec3(lessThan(v, vec3(0.081))));
}

void main() {
  ivec2 id = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(outTex);
  if (id.x >= size.x || id.y >= size.y)
    return;
  vec4 color = imageLoad(inTex, id);
  if (ubo.opacity > 0.0f) {
    vec2 uv = vec2(id.x + 0.5, id.y + 0.5) / vec2(size);
    vec4 rect = vec4(ubo.centerX - ubo.width * 0.5f, ubo.centerY - ubo.height * 0.5f,
                     ubo.centerX + ubo.width * 0.5f, ubo.centerY + ubo.height * 0.5f);
    if (uv.x >= rect.x && uv.x < rect.z && uv.y >= rect.y && uv.y < rect.w) {
      // 反算采样点; 越界必须显式丢弃(sampler 是 clamp-to-edge,
      // 靠它会把画布边缘 alpha 拉花到内容边界; 缩小时反算点会出画布)
      vec2 suv = vec2(ubo.originX, ubo.originY) + uv * ubo.invScale;
      if (suv.x >= 0.0f && suv.x <= 1.0f && suv.y >= 0.0f && suv.y <= 1.0f) {
        vec4 overlay = textureLod(inTex2, suv, 0.0);
        // 线性域 source-over: canvas 线性化×参考白(SDR 白=203nit=2.5375×80nit),
        // alpha 是几何覆盖度不过域变换; opacity<1 时 rgb 随 alpha 同乘防白漂
        vec3 srcLin = sdrToLinear(overlay.rgb) * vec3(203.0 / 80.0);
        vec4 src = vec4(srcLin * ubo.opacity, overlay.a * ubo.opacity);
        color.rgb = src.rgb + color.rgb * (1.0f - src.a);
      }
    }
  }
  imageStore(outTex, id, color);
}
