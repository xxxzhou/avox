// 导向滤波自引导去块: 逐通道求解 a (每通道独立 1D guided filter, guidance=该通道自身)
// in0: mean_c  (box 平滑的原图, vec3)
// in1: mean_cc (box 平滑的 c², vec3)
//   var_c = mean_cc - mean_c²  (逐通道方差)
//   a = var_c / (var_c + eps)   (平坦区 a≈0→趋向均值=平滑去块; 边缘 a≈1→保留)
// out: a (vec3), a∈[0,1]
// 与 guidedFilter2.comp(3D guidance+标量p, 抠图用) 不同: 本 shader 逐通道独立, 保色
#version 450

layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0, rgba32f) uniform readonly image2D inTex;   // mean_c
layout (binding = 1, rgba32f) uniform readonly image2D inTex1;  // mean_cc
layout (binding = 2, rgba32f) uniform image2D outTex;           // a
layout (binding = 3) uniform UBO {
    float eps;
} ubo;

void main() {
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if (uv.x >= size.x || uv.y >= size.y) {
        return;
    }
    vec3 mean_c = imageLoad(inTex, uv).rgb;
    vec3 mean_cc = imageLoad(inTex1, uv).rgb;
    vec3 var_c = max(mean_cc - mean_c * mean_c, vec3(0.0));
    vec3 a = var_c / (var_c + vec3(ubo.eps));
    imageStore(outTex, uv, vec4(a, 1.0));
}
