#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D srcTex;
layout(binding = 1) uniform sampler2D statsMaxTex;
layout(binding = 2, rgba8) uniform writeonly image2D dstTex;
layout(std140, binding = 3) uniform UBO {
	int width;
	int height;
} ubo;

void main() {
	ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
	if (pos.x >= ubo.width || pos.y >= ubo.height) return;

	vec2 uv = (vec2(pos) + 0.5) / vec2(ubo.width, ubo.height);

	vec4 color = texture(srcTex, uv);
	float statsMax = texture(statsMaxTex, uv).r;

	// Clamp current pixel luma to local max luma
	float luma = dot(color.rgb, vec3(0.299, 0.587, 0.114));
	if (luma > statsMax) {
		color.rgb *= statsMax / luma;
	}

	imageStore(dstTex, pos, color);
}
