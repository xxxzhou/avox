#version 450

// 基础图像调整: 色调/亮度/对比度/饱和度/伽玛 合并到单 shader 单 pass
// 算子顺序: 亮度 -> 对比度 -> clamp[0,1] -> 伽玛 -> 饱和度 -> 色调

layout (local_size_x = 16, local_size_y = 16) in;// gl_WorkGroupSize

layout (binding = 0, rgba8) uniform readonly image2D inTex;
layout (binding = 1, rgba8) uniform image2D outTex;

// 字段顺序与 C++ 端 BasicAdjustParamet 一致; 用单个 float 避免 std140 padding
layout (std140, binding = 2) uniform UBO {
    float hue;        // 色调(度), -360~360, 0=不变
    float brightness; // 亮度, -1~1, 0=不变
    float contrast;   // 对比度, 0~2, 1=不变
    float saturation; // 饱和度, 0~2, 1=不变
    float gamma;      // 伽玛, 0~3, 1=不变
} ubo;

// 饱和度用到的亮度权重 (与 saturation.comp 一致)
const vec3 W = vec3(0.2125, 0.7154, 0.0721);

// YIQ 色调旋转常量 (与 hue.comp 一致)
const vec4 kRGBToYPrime = vec4(0.299, 0.587, 0.114, 0.0);
const vec4 kRGBToI      = vec4(0.595716, -0.274453, -0.321263, 0.0);
const vec4 kRGBToQ      = vec4(0.211456, -0.522591, 0.31135, 0.0);
const vec4 kYIQToR      = vec4(1.0, 0.9563, 0.6210, 0.0);
const vec4 kYIQToG      = vec4(1.0, -0.2721, -0.6474, 0.0);
const vec4 kYIQToB      = vec4(1.0, -1.1070, 1.7046, 0.0);

void main(){
    ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inTex);
    if(uv.x >= size.x || uv.y >= size.y){
        return;
    }
    vec4 color = imageLoad(inTex, uv);
    vec3 c = color.rgb;

    // 亮度
    c = c + vec3(ubo.brightness);
    // 对比度
    c = (c - vec3(0.5)) * ubo.contrast + vec3(0.5);
    // gamma 前必须 clamp, 否则 pow(负数, 分数) 会产生 NaN
    c = clamp(c, 0.0, 1.0);
    // 伽玛
    c = pow(c, vec3(ubo.gamma));
    // 饱和度
    float luminance = dot(c, W);
    c = mix(vec3(luminance), c, ubo.saturation);
    // 色调 (度->弧度, YIQ 旋转, 与 hue.comp 一致取负向旋转)
    float hueRad = ubo.hue * 3.14159265358979323846 / 180.0;
    float YPrime = dot(vec4(c, 0.0), kRGBToYPrime);
    float I = dot(vec4(c, 0.0), kRGBToI);
    float Q = dot(vec4(c, 0.0), kRGBToQ);
    float hue = atan(Q, I);
    float chroma = sqrt(I * I + Q * Q);
    hue += (-hueRad);
    Q = chroma * sin(hue);
    I = chroma * cos(hue);
    vec4 yIQ = vec4(YPrime, I, Q, 0.0);
    c.r = dot(yIQ, kYIQToR);
    c.g = dot(yIQ, kYIQToG);
    c.b = dot(yIQ, kYIQToB);

    imageStore(outTex, uv, vec4(c, color.a));
}
