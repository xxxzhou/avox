#version 450

layout (local_size_x = 16, local_size_y = 16) in;
layout (binding = 0, rgba8) uniform readonly image2D inTex;
layout (binding = 1, rgba8) uniform image2D outTex;
// std140: 3 个 int 后 mat4 自动对齐到 offset 16, 共 80B
layout (std140, binding = 2) uniform UBO {
	int width;
	int height;
	int yuvType;
	mat4 colorMat;  // 行优先 RGB->YUV, 用法 vec4(rgb,1)*colorMat (向量在左)
} ubo;

void main(){
	ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outTex);
    if(uv.x >= size.x || uv.y >= size.y){
        return;
    }
	// yuv2I
	int bitx = 0;
	int yoffset = 0;
	// yvyuI
	if(ubo.yuvType == 6){
		bitx= 2;
	}
	// uyvyI
	if(ubo.yuvType == 7){
		yoffset = 1;
	}

	vec4 rgba1 = imageLoad(inTex,ivec2(uv.x*2,uv.y)).rgba;
    vec4 rgba2 = imageLoad(inTex,ivec2(uv.x*2+1,uv.y)).rgba;

    vec4 yuv1 = vec4(rgba1.rgb,1.0) * ubo.colorMat;
    vec4 yuv2 = vec4(rgba2.rgb,1.0) * ubo.colorMat;

    vec4 yuyv = vec4(yuv1.x, (yuv1.y + yuv2.y) / 2.f, yuv2.x,
                                   (yuv1.z + yuv2.z) / 2.f);
    vec4 syuyv = vec4(yuyv[yoffset], yuyv[bitx + (1 - yoffset)],
                        yuyv[yoffset + 2], yuyv[(2 - bitx) + (1 - yoffset)]);
	imageStore(outTex, uv,syuyv);
}
