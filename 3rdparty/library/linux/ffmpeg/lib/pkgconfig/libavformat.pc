exec_prefix=${prefix}
libdir=/home/zhouxin/ffmpeg-out-linux/lib
includedir=/home/zhouxin/ffmpeg-out-linux/include

Name: libavformat
Description: FFmpeg container format library
Version: 63.1.101
Requires: 
