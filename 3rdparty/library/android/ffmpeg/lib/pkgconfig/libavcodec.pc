prefix=./android/armv8-a
exec_prefix=${prefix}
libdir=./android/armv8-a/lib
includedir=./android/armv8-a/include

Name: libavcodec
Description: FFmpeg codec library
Version: 61.3.100
Requires: libswresample >= 5.1.100, libavutil >= 59.8.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavcodec -pthread -lm -latomic -landroid -lz
Libs.private: 
Cflags: -I${includedir}
