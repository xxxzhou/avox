prefix=/d/Work/github/ffmpeg/out-android-arm64
exec_prefix=${prefix}
libdir=/d/Work/github/ffmpeg/out-android-arm64/lib
includedir=/d/Work/github/ffmpeg/out-android-arm64/include

Name: libavcodec
Description: FFmpeg codec library
Version: 63.1.101
Requires: 
Requires.private: libswresample >= 7.1.101, libavutil >= 61.1.101
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm -latomic -lz
Cflags: -I${includedir}
