#ifndef __GIT_VERSION_H__
#define __GIT_VERSION_H__

#define AVOX_COMMIT_HASH "@AVOX_COMMIT_HASH@"
#define AVOX_COMMIT_TIME "@AVOX_COMMIT_TIME@"
#define AVOX_BRANCH_NAME "@AVOX_BRANCH_NAME@"
#define AVOX_BUILD_TIME "@AVOX_BUILD_TIME@"
#define AVOX_COMMIT_VERSION "@AVOX_COMMIT_VERSION@"

// 数字版本 (供 Windows AvoxVersion.rc 的 FILEVERSION 使用,必须无前导零,否则被当成八进制)
#define AVOX_VER_MAJOR @AVOX_VERSION_MAJOR@
#define AVOX_VER_MINOR @AVOX_VERSION_MINOR@
#define AVOX_VER_PATCH @AVOX_VERSION_PATCH_NUM@

#endif //__GIT_VERSION_H__